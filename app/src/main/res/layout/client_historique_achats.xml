<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ClientAccueil">


    <!-- Barre du haut -->
    <View
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@color/purple_50"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/topAppBar"
        layout="@layout/client_top_tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/topPanel" />

    <!-- Barre de recherche -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/barreRecherche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:iconifiedByDefault="false"
        app:queryHint="@string/rechercher"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@color/purple_51" />

    <ImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:paddingTop="12dp"
        android:paddingRight="10dp"
        android:src="@drawable/ic_filtres_recherche"
        app:layout_constraintTop_toBottomOf="@+id/topAppBar"
        app:layout_constraintEnd_toEndOf="@+id/barreRecherche"/>

    <!-- Contenu de la page -->
    <TextView
        android:id="@+id/titreCommandes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vosCommandes"
        app:layout_constraintTop_toBottomOf="@+id/barreRecherche"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_margin="12dp"
        android:paddingBottom="20dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCommandes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/titreCommandes"
        app:layout_constraintBottom_toTopOf="@+id/include"
        android:clipToPadding="false"
        android:scrollbars="vertical"/>

    <!-- Barre du bas -->
    <include
        android:id="@+id/include"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        layout="@layout/client_bottom_tool_bar"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel" />

    <View
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@color/purple_50"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
