<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Barre du haut -->
    <View
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@color/purple_50"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/topAppBar"
        layout="@layout/boutique_top_tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/topPanel" />

    <!-- Image profil -->
    <ImageView
        android:id="@+id/mainProfilePhoto"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentEnd="true"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>


    <!-- Titre -->
    <TextView
        android:id="@+id/titre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aProposTitre"
        android:textSize="16sp"
        android:textColor="#1E1E1E"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/mainProfilePhoto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Contenu de la page -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:background="#F2EAFB"
        app:layout_constraintTop_toBottomOf="@id/titre"
        app:layout_constraintBottom_toTopOf="@+id/include"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Mes Informations -->
            <LinearLayout
                android:id="@+id/infos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#E8DAF8"
                android:gravity="center_vertical"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="@string/mesInfos" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mesInfos"
                    android:layout_marginStart="16dp"
                    android:textSize="16sp"
                    android:textColor="#1E1E1E" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1C4E9" />

            <!-- Mes Produits -->
            <LinearLayout
                android:id="@+id/btnMyProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#E8DAF8"
                android:gravity="center_vertical"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_mes_produits"
                    android:contentDescription="@string/mesProduits" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mesProduits"
                    android:layout_marginStart="16dp"
                    android:textSize="16sp"
                    android:textColor="#1E1E1E" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1C4E9" />

            <!-- Historique des ventes -->
            <LinearLayout
                android:id="@+id/btnSalesHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#E8DAF8"
                android:gravity="center_vertical"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_hist_achat"
                    android:contentDescription="@string/Historique" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Historique"
                    android:layout_marginStart="16dp"
                    android:textSize="16sp"
                    android:textColor="#1E1E1E" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1C4E9" />

            <!-- Paramètres -->
            <LinearLayout
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#E8DAF8"
                android:gravity="center_vertical"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_params"
                    android:contentDescription="@string/params" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/params"
                    android:layout_marginStart="16dp"
                    android:textSize="16sp"
                    android:textColor="#1E1E1E" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1C4E9" />

            <!-- FAQ -->
            <LinearLayout
                android:id="@+id/btnFaq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#E8DAF8"
                android:gravity="center_vertical"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_faq"
                    android:contentDescription="@string/faq" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/faq"
                    android:layout_marginStart="16dp"
                    android:textSize="16sp"
                    android:textColor="#1E1E1E" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1C4E9" />

            <!-- À propos de -->
            <LinearLayout
                android:id="@+id/btnAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#E8DAF8"
                android:gravity="center_vertical"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_apropos"
                    android:contentDescription="@string/aProposTitre" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aProposTitre"
                    android:layout_marginStart="16dp"
                    android:textSize="16sp"
                    android:textColor="#1E1E1E" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1C4E9" />

            <!-- Mentions légales -->
            <LinearLayout
                android:id="@+id/btnLegal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#E8DAF8"
                android:gravity="center_vertical"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_mentions_legales"
                    android:contentDescription="@string/mentionsLegales" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mentionsLegales"
                    android:layout_marginStart="16dp"
                    android:textSize="16sp"
                    android:textColor="#1E1E1E" />
            </LinearLayout>


            <Button
                android:id="@+id/btnDeconnexion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Deconnexion"
                android:background="@color/teal_200"
                android:textColor="#000000"
                android:layout_marginTop="16dp" />


        </LinearLayout>
    </ScrollView>


    <!-- Barre du bas -->
    <include
        android:id="@+id/include"
        layout="@layout/boutique_bottom_tool_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel" />

    <View
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:background="@color/purple_50"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
